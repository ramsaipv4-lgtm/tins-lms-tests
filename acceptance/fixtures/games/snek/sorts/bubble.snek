N = {{N}}
seed = 12345
data = []
for i in range(N):
    seed = (seed * 75 + 74) % 65537
    data.append(seed % 1000)
def bubble(xs):
    n = len(xs)
    for i in range(n):
        for j in range(n - 1 - i):
            if xs[j] > xs[j + 1]:
                xs[j], xs[j + 1] = xs[j + 1], xs[j]
    return xs
out = bubble(data)
print(out[0], out[-1], len(out))
